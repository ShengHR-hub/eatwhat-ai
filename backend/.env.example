# 数据库
# 本机当前用原生 PostgreSQL 16（D:\PostgreSQL\16，数据 D:\PGData\16，端口 5433）
DATABASE_URL=postgresql+psycopg://eatwhat:eatwhat_dev@127.0.0.1:5433/eatwhat
# 回退到 SQLite（演示/离线可用）：
# DATABASE_URL=sqlite:///D:/EatWhat/backend/eatwhat.db

# 是否允许启动时 create_all 建表。
# 不填时：SQLite 默认开、PostgreSQL 默认关。生产必须保持关闭，改用 alembic upgrade head。
# AUTO_CREATE_SCHEMA=0

# 允许的前端来源，逗号分隔；生产不要用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# 高德 Web 服务 Key（天气/POI，可选；不配则天气走 Open-Meteo）
AMAP_API_KEY=

# 冰箱拍照识别：OpenAI 兼容视觉模型
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash
